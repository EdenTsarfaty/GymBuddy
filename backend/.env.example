# Copy this file to .env and fill in your keys.

# Required: plan generation, exercise chat and swaps
OPENAI_API_KEY=

# OpenAI parameters (optional: these are the defaults)
# Both models must support reasoning effort. The context window is the chat's
# total token window for the plan model, so set it to match that model.
OPENAI_MODEL=gpt-5.6-luna
OPENAI_PLAN_MODEL=gpt-5.6-luna
OPENAI_CONTEXT_WINDOW=1050000

# Optional
PORT=3001
# Addresses the app may be opened from, comma-separated (e.g. a Tailscale or hosted address)
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:4173

# Exercise photos (Serper) and videos (YouTube Data API)
SERPER_API_KEY=
YOUTUBE_API_KEY=

# Push notifications (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
